  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Guest kick reaches the backend as a kick eventfd",
        "Backend reads descriptors from the shared memfd",
        "RemoteDisk splits at object boundaries; each chunk is one partial GET"
      ]
    },
    {
      "dot": "emerald",
      "title": "Completion path",
      "items": [
        "GET data lands directly in a per-request bounce buffer",
        "Reply flows back up: CQE \u2192 Completion \u2192 callback",
        "Backend copies to guest RAM, updates used ring, signals call eventfd"
      ]
    },
    {
      "dot": "amber",
      "title": "Boundaries",
      "items": [
        "Read-only: writes and flush get an error status",
        "nebula_ddl3 is NebulaR's library, linked, not copied",
        "minifs-populate is offline provisioning, not on the I/O path"
      ]
    },
    {
      "dot": "slate",
      "title": "Source files",
      "items": [
        "vhost_user_blk.cc: virtqueue + protocol",
        "remote_disk.cc, disk_mapping.cc: chunking",
        "minifs_adapter.cc: CoreClient (NebulaR ddl3)"
      ]
    }
  ]
