  "cards": [
    {
      "dot": "cyan",
      "title": "Worked example",
      "items": [
        "Offset 1,044,480 is 4 KiB before the first 1 MiB object ends",
        "So 8 KiB becomes two partial GETs: objects 1 and 2",
        "Object id = (object-hi, object-start + index)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Exactly once",
      "items": [
        "One callback after all chunks settle, never inside read()",
        "Any chunk error fails the request: virtio status IOERR",
        "Queue-full is retried a bounded number of times"
      ]
    },
    {
      "dot": "slate",
